const value = (w: Written): Binary128 => {
  if (w === '+0') return zero(1);
  if (w === '-0') return zero(-1);
  if (w === 'inf') return infinity(1);
  if (w === '-inf') return infinity(-1);
  return finite(BigInt(w[0]), w[1]);
};
const key = (x: Binary128) => {
  if (x.cls === 'nan') return 'nan';
  if (x.cls === 'infinity') return x.sign === -1 ? '-inf' : 'inf';
  if (x.sig === 0n) return x.sign === -1 ? '-0' : '+0';
  return `${x.sig}p${x.exp}`;
};
const call = (fn: string, args: Binary128[]) => (T as unknown as Record<string, (...v: Binary128[]) => Binary128>)[fn](...args);

test('every anchor is the correctly rounded value', () => {
  for (const [fn, args, want] of ANCHORS) {
    expect(key(call(fn, args.map(value))), `${fn}(${JSON.stringify(args)})`).toBe(key(value(want)));
  }
});

test("the special values are ECMAScript's", () => {
  const one = finite(1n, 0);
  const half = finite(1n, -1);
  const two = finite(1n, 1);
  const table: [string, Binary128[], string][] = [
    ['sin', [zero(-1)], '-0'], ['sin', [infinity(1)], 'nan'], ['cos', [zero(-1)], '1p0'], ['tan', [zero(-1)], '-0'],
    ['asin', [two], 'nan'], ['asin', [zero(-1)], '-0'], ['acos', [one], '+0'], ['acos', [two], 'nan'],
    ['atan', [zero(-1)], '-0'], ['exp', [infinity(-1)], '+0'], ['exp', [zero(-1)], '1p0'], ['expm1', [zero(-1)], '-0'],
    ['expm1', [infinity(-1)], '-1p0'], ['log', [zero(1)], '-inf'], ['log', [finite(-1n, 0)], 'nan'], ['log', [one], '+0'],
    ['log1p', [finite(-1n, 0)], '-inf'], ['log1p', [zero(-1)], '-0'], ['log2', [finite(1n, 10)], '5p1'], ['log10', [finite(125n, 3)], '3p0'],
    ['sinh', [zero(-1)], '-0'], ['cosh', [infinity(-1)], 'inf'], ['tanh', [infinity(-1)], '-1p0'], ['tanh', [zero(-1)], '-0'],
    ['asinh', [zero(-1)], '-0'], ['acosh', [one], '+0'], ['acosh', [half], 'nan'], ['atanh', [one], 'inf'], ['atanh', [finite(-1n, 0)], '-inf'],
    ['atanh', [two], 'nan'], ['atanh', [zero(-1)], '-0'], ['sin', [NAN], 'nan'],
    ['atan2', [zero(1), zero(1)], '+0'], ['atan2', [zero(-1), zero(1)], '-0'], ['atan2', [zero(-1), infinity(1)], '-0'],
    ['atan2', [one, infinity(1)], '+0'], ['atan2', [NAN, one], 'nan'],
  ];
  for (const [fn, args, want] of table) {
    expect(key(call(fn, args)), `${fn}(${args.map(key).join(', ')})`).toBe(want);
  }
  // The angles are pi and its fractions, correctly rounded: atan2(+-0, -0) is +-pi, atan2(y, 0) is +-pi/2.
  expect(key(call('atan2', [zero(1), zero(-1)]))).toBe(key(call('acos', [finite(-1n, 0)])));
  expect(key(call('atan2', [zero(-1), zero(-1)]))).toBe(key(call('acos', [finite(-1n, 0)])).replace(/^/, '-'));
  expect(key(call('atan2', [one, zero(1)]))).toBe(key(call('asin', [one])));
  expect(key(call('atan', [infinity(1)]))).toBe(key(call('asin', [one])));
});

const Q = (n: number | string) => `(${n} := float128)`;
const show = (e: string) => evaluated(`String(${e});`);

test('through JavaScript: the type is kept, and ** and Math.pow agree', () => {
  expect(show(`Math.sin(${Q(1)})`)).toBe('0.841470984807896506652502321630299');
  expect(evaluated(`String(Reflect.typeOf(Math.atan2(${Q(1)}, -${Q(1)})));`)).toBe('float128');
  expect(show(`Math.acos(-${Q(1)})`)).toBe('3.1415926535897932384626433832795028');
  expect(show(`${Q(2)} ** 0.5`)).toBe(show(`Math.sqrt(${Q(2)})`));
  expect(show(`Math.pow(${Q(2)}, ${Q(0.5)})`)).toBe(show(`${Q(2)} ** ${Q(0.5)}`));
  // A negative base to an odd integer power too large to compute exactly keeps its sign.
  expect(show(`(-(1.0000001 := float128)) ** ((2n ** 80n + 1n) := float128)`)).toBe('-Infinity');
  expect(show(`(-(1.0000001 := float128)) ** ((2n ** 80n) := float128)`)).toBe('Infinity');
  // A negative base to a non-integer power has no real value.
  expect(show(`(-${Q(2)}) ** 0.5`)).toBe('NaN');
  expectThrownKind(`let n = 1; Math.atan2(${Q(1)}, n);`, 'TypeError');
});

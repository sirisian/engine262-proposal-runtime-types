{
  "cases": [
    {
      "name": "stored specialization has own parameter scope",
      "source": "const N=8;function sized(n:uint32):type{return type [n/8].<uint8>;}function f<N:uint32,U:type=sized(N)>(x:U):U{return x;}const g=f.<16>;g([1,2]);\"ok\";",
      "expected": {
        "completion": "normal",
        "bodyEntered": true,
        "value": "ok"
      }
    },
    {
      "name": "labelled do producer",
      "source": "let n: uint8 = do { done: { 1; break done; \"unreachable\"; } }; String(n);",
      "expected": {
        "completion": "normal",
        "bodyEntered": true,
        "value": "1"
      }
    },
    {
      "name": "nested labelled do producer",
      "source": "let n: uint8 = do { outer: { inner: { 2; break outer; } \"unreachable\"; } }; String(n);",
      "expected": {
        "completion": "normal",
        "bodyEntered": true,
        "value": "2"
      }
    },
    {
      "name": "abrupt finally do producer",
      "source": "let n: uint8 = do { done: { try { \"s\"; break done; } finally { 3; break done; } } }; String(n);",
      "expected": {
        "completion": "normal",
        "bodyEntered": true,
        "value": "3"
      }
    },
    {
      "name": "class primitive comparison with narrowed binding",
      "source": "function __never() { class C {} class D2 {} let c: C = new C(); let d: D2 = new D2(); enum E { A = 1, B = 2 } let e: E = E.A; let s: string = \"x\"; let n: uint8 = uint8(1); let q = c === s; }",
      "expected": {
        "completion": "throw",
        "bodyEntered": false,
        "errorClass": "StaticTypeError",
        "diagnostic": {
          "code": "RT_DISJOINT_COMPARISON",
          "rule": "rt-disjoint-comparison",
          "phase": "static"
        }
      }
    },

    {
      "name": "iterator closes source after output failure",
      "steps": [
        {
          "source": "let log=\"\";const source:any={next(){log+=\"n\";return {value:1,done:false};},return(){log+=\"r\";return {done:true};}};const map:any=Iterator.prototype.map.<string>;const callback:any=()=>({});const it:any=map.call(source,callback);try{it.next();}catch(e){log+=e instanceof TypeError?\"e\":\"x\";}String(it.next().done)+\"/\"+log;",
          "expected": {
            "completion": "normal",
            "bodyEntered": true,
            "scriptBodies": 1,
            "value": "true/nre"
          }

{
  "cases": [
    {
      "name": "range explicit string",
      "steps": [
        {
          "source": "String((1..<4).map.<string>(v=>String(v)).toArray());",
          "expected": {
            "completion": "normal",
            "bodyEntered": true,
            "scriptBodies": 1,
            "value": "1,2,3"
          }
        }
      ]
    },
    {
      "name": "range named callback",
      "steps": [
        {
          "source": "String((1..<4).map.<string>(callback:v=>String(v)).toArray());",
          "expected": {
            "completion": "normal",
            "bodyEntered": true,
            "scriptBodies": 1,
            "value": "1,2,3"
          }
        }
      ]
    },
    {
      "name": "range named type and object spread",
      "steps": [
        {
          "source": "const r:any=(1..<4);String(r.map.<U:string>(...{callback:v=>String(v)}).toArray());",
          "expected": {
            "completion": "normal",
            "bodyEntered": true,
            "scriptBodies": 1,
            "value": "1,2,3"
          }
        }
      ]
    },
    {
      "name": "range spread type argument",
      "steps": [
        {
          "source": "const r:any=(1..<4);String(r.map.<...[string]>(v=>String(v)).toArray());",
          "expected": {
            "completion": "normal",
            "bodyEntered": true,
            "scriptBodies": 1,
            "value": "1,2,3"
          }
        }
      ]
    },
    {
      "name": "range gradual numeric-to-string admission",
      "steps": [
        {
          "source": "const r:any=(1..<4);const callback:any=v=>v;const it:any=r.map.<string>(callback);const item=it.next().value;typeof item+\"/\"+item;",
          "expected": {
            "completion": "normal",
            "bodyEntered": true,
            "scriptBodies": 1,
            "value": "string/1"
          }
        }
      ]
    },
    {
      "name": "range lazy callbacks and cached closed output",
      "steps": [
        {
          "source": "const r:any=(1..<4);let calls=0;const callback:any=v=>{calls++;return v;};const it:any=r.map.<string>(callback);const before=calls;const first=it.next().value;String(before)+\"/\"+String(calls)+\"/\"+typeof first;",
          "expected": {
            "completion": "normal",
            "bodyEntered": true,
            "scriptBodies": 1,
            "value": "0/1/string"
          }
        }
      ]
    },
    {
      "name": "range independent specializations",
      "steps": [
        {
          "source": "const r:any=(1..<4);String(r.map.<string>===r.map.<U:string>)+\"/\"+String(r.map.<string>===r.map.<number>);",
          "expected": {
            "completion": "normal",
            "bodyEntered": true,
            "scriptBodies": 1,
            "value": "true/false"
          }
        }
      ]
    },
    {
      "name": "range extraction does not bind receiver",
      "steps": [
        {
          "source": "const r:any=(1..<4);const f:any=r.map.<string>;f(v=>String(v));",
          "expected": {
            "completion": "throw",
            "bodyEntered": true,
            "scriptBodies": 1,
            "errorClass": "TypeError"
          }
        }
      ]
    },
    {
      "name": "range stored application with reflective receiver",
      "steps": [
        {
          "source": "const r:any=(1..<4);const f:any=r.map.<string>;String(f.call(r,v=>String(v)).toArray());",
          "expected": {
            "completion": "normal",
            "bodyEntered": true,
            "scriptBodies": 1,
            "value": "1,2,3"
          }
        }
      ]
    },
    {
      "name": "range stored bound callable",
      "steps": [
        {
          "source": "const r:any=(1..<4);const f:any=r.map.<string>;const bound=f.bind(r);String(bound(v=>String(v)).toArray());",
          "expected": {

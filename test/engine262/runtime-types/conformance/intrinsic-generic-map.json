            "bodyEntered": true,
            "scriptBodies": 1,
            "value": "1,2,3"
          }
        }
      ]
    },
    {
      "name": "range public name and length do not alter application",
      "steps": [
        {
          "source": "const r:any=(1..<4);Object.defineProperty(r.map,\"name\",{value:\"x\"});Object.defineProperty(r.map,\"length\",{value:99});String(r.map.<string>(v=>String(v)).next().value);",
          "expected": {
            "completion": "normal",
            "bodyEntered": true,
            "scriptBodies": 1,
            "value": "1"
          }
        }
      ]
    },
    {
      "name": "range identity survives lexical generic scope",
      "steps": [
        {
          "source": "const r:any=(1..<4);function make<T:type>(){return r.map.<T>;}const f:any=make.<string>();const callback:any=v=>v;const it:any=f.call(r,callback);typeof it.next().value;",
          "expected": {
            "completion": "normal",
            "bodyEntered": true,
            "scriptBodies": 1,
            "value": "string"
          }
        }
      ]
    },

      "steps": [
        {
          "source": "let log=\"\";const source:any={next(){return {value:1,done:false};},return(){log+=\"r\";return {done:true};}};const map:any=Iterator.prototype.map.<string>;const callback:any=()=>{throw \"callback\";};const it:any=map.call(source,callback);try{it.next();}catch(e){log+=String(e);}log;",
          "expected": {

    {
      "name": "noncallable next is not advanced at creation",
      "steps": [
        {
          "source": "let calls=0;const source:any={next:4};const map:any=Iterator.prototype.map.<string>;const callback:any=()=>{calls++;return \"x\";};const it:any=map.call(source,callback);let threw=false;try{it.next();}catch(e){threw=e instanceof TypeError;}String(calls)+\"/\"+String(threw);",
          "expected": {
            "completion": "normal",
            "bodyEntered": true,
            "scriptBodies": 1,
            "value": "0/true"
          }
        }
      ]
    },
    {
      "name": "callee getter runs once and before value arguments",
      "steps": [
        {
          "source": "const r:any=1..<3;const p=Object.getPrototypeOf(r);const original=p.map;let log=\"\";Object.defineProperty(p,\"map\",{get(){log+=\"g\";return original;}});function f(){log+=\"a\";return v=>String(v);}const it:any=r.map.<string>(f());String(it.next().value)+\"/\"+log;",
          "expected": {
            "completion": "normal",

    },
    {
      "name": "inner generic replacement receives output type and original callback",
      "steps": [
        {
          "source": "const r:any=1..<3;const p=Object.getPrototypeOf(Object.getPrototypeOf(r.step(1)));let observed=\"\";const callback:any=v=>String(v);p.map=function<V:type>(f){observed=String(V===string)+\"/\"+String(f===callback);return this;};r.map.<string>(callback);observed;",
          "expected": {
            "completion": "normal",

    {
      "name": "output error wins over throwing close",
      "steps": [
        {
          "source": "let log=\"\";const source:any={next(){return {value:1,done:false};},return(){log+=\"r\";throw \"close\";}};const map:any=Iterator.prototype.map.<string>;const callback:any=()=>({});const it:any=map.call(source,callback);try{it.next();}catch(e){log+=e instanceof TypeError?\"type\":\"other\";}log;",
          "expected": {
            "completion": "normal",
            "bodyEntered": true,
            "scriptBodies": 1,
            "value": "rtype"
          }
        }

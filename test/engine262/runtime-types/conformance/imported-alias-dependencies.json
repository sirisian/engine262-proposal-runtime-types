{
  "description": "Producer environments and retained inner alias applications at their required checking boundaries. Four unresolved evaluability/handled cyclic-input observations are recorded separately, not accepted as conformance results.",
  "cases": [
    {
      "name": "cycle-computed",
      "modules": {
        "main": "import {marker} from \"dep\";const B=string;function bound():type{return B;}export type I<T:type extends bound()> = T;",
        "dep": "import {I} from \"main\";export const marker=1;I.<string>;"
      },
      "expected": {
        "status": "rejected",
        "bodyEntries": [],
        "errorClass": "StaticTypeError",
        "diagnostic": {
          "code": "RT_TYPE_EVALUATION",
          "rule": "rt-type-evaluation",
          "phase": "pre-evaluation"
        }
      }
    },
    {
      "name": "where-source-bad",
      "modules": {
        "main": "import {I} from \"dep\";function allowed(n:uint32):boolean{return true;}I.<0>;",
        "dep": "function allowed(n:uint32):boolean{return n>0;}export type I<N:uint32> = uint32 where allowed(N);"
      },
      "expected": {
        "status": "rejected",
        "bodyEntries": [
          "dep"
        ],
        "errorClass": "StaticTypeError",
        "diagnostic": {
          "code": "RT_WHERE_UNSATISFIED",
          "rule": "rt-where-unsatisfied",
          "phase": "pre-evaluation"
        }
      }
    },

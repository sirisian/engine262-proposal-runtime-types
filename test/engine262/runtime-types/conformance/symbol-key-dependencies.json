      "steps": [
        {
          "source": "let log=\"\";function make(tag:string){class P{tag:string=tag;constructor(v:string){log+=tag;}}return(v:any)=>{const p:P=v;return p;};}const a=make(\"a\"),b=make(\"b\");function choose(flag:boolean){if(flag)return a(\"x\");return b(\"x\");}const k=Symbol(\"p\");const h={[k]:choose(false)};const p=h[k];p.tag+\":\"+log;",
          "expected": {
            "completion": "normal",
            "bodyEntered": true,
            "scriptBodies": 1,
            "value": "b:b"
          }
        }
      ]
    },

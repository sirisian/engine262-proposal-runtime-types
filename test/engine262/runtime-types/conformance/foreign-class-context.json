{
  "description": "Producer-owned imported class descriptions and captured contexts at inferred admission; source availability and failure-order controls.",
  "cases": [
    {
      "name": "extra-import-control",
      "modules": {
        "main": "import {E} from \"dep\";import {Has} from \"provider\";export const marker=1;",
        "dep": "import {Has} from \"provider\";export class E implements Has.<E>{get():E{return this;}}",
        "provider": "import {marker} from \"main\";export interface Has<T:type>{get():T;}"
      },
      "expected": {
        "status": "fulfilled",
        "bodyEntries": [
          "provider",
          "dep",
          "main"
        ]
      }
    },
    {
      "name": "missing-import",
      "modules": {
        "main": "import {E} from \"dep\";export const marker=1;",
        "dep": "import {Has} from \"provider\";export class E implements Has.<E>{get():E{return this;}}",
        "provider": "import {marker} from \"main\";export interface Has<T:type>{get():T;}"
      },
      "expected": {
        "status": "fulfilled",
        "bodyEntries": [
          "provider",
          "dep",
          "main"
        ]
      }
    },
    {

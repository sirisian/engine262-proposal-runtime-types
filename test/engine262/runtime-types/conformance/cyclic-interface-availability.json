    {
      "name": "available-third-module-in-cycle",
      "modules": {
        "main": "import {E} from \"dep\";import {Has} from \"provider\";export const marker=1;",
        "dep": "import {Has} from \"provider\";export class E implements Has.<E>{get():E{return this;}}",
        "provider": "import {marker} from \"main\";export interface Has<T:type>{get():T;}"
      },
      "expected": {
        "status": "fulfilled",
        "bodyEntries": [
          "provider",
          "dep",
          "main"
        ]
      }
    },
    {
      "name": "nested-interface-shadows-import",
      "modules": {
        "main": "import {f} from \"dep\";export interface Has<T:type>{get():T;}",
        "dep": "import {Has} from \"main\";export function f(){interface Has{get():string;}class E implements Has{get():string{return \"ok\";}}}"
      },
      "expected": {
        "status": "fulfilled",
        "bodyEntries": [
          "dep",
          "main"
        ]
      }
    },
    {
      "name": "runtime-exception-in-earlier-dependency",
      "modules": {
        "main": "import \"seed\";import {E} from \"dep\";export interface Has<T:type>{get():T;}",
        "seed": "throw new Error(\"dependency\");",
        "dep": "import {Has} from \"main\";export class E implements Has.<E>{get():E{return this;}}"
      },
      "expected": {
        "status": "rejected",
        "bodyEntries": [
          "seed"
        ],
        "errorClass": "Error"
      }
    },
    {
      "name": "static-contract-failure-precedes-availability",
      "modules": {
        "main": "import {E} from \"dep\";export interface Has<T:type>{get():T;}",
        "dep": "import {Has} from \"main\";export class E implements Has.<string>{get():boolean{return true;}}"
      },
      "expected": {
        "status": "rejected",
        "bodyEntries": [],
        "errorClass": "StaticTypeError",
        "diagnostic": {
          "code": "RT_ASSIGNABILITY",
          "phase": "static"
        }
      }
    }
  ]
}

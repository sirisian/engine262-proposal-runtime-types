      "steps": [
        {
          "source": "function* f():Generator.<uint8,string,void>{return \"end\";}const x=f().next();if(x.done===true&&x.value!==undefined){const v:string=x.value;}\"ok\";",
          "expected": {
            "completion": "normal",
            "bodyEntered": true,
            "value": "ok"
          }
        }
      ]
    },
    {
      "name": "gradual next replacement preserves terminal payload",
      "steps": [
        {
          "source": "function* f():uint8{}const it=f();it.next=()=>({done:true,value:\"terminal\"});const x=it.next();if(x.value!==\"terminal\")throw new Error(\"result\");\"ok\";",
          "expected": {
            "completion": "normal",
            "bodyEntered": true,
            "value": "ok"
          }
        }
      ]
    },
    {
      "name": "wrong yielded record still fails receiving admission",
      "steps": [
        {
          "source": "const raw:any={value:\"bad\",done:false};const x:IteratorResult.<uint8,void>=raw;",
          "expected": {
            "completion": "throw",
            "bodyEntered": true,
            "errorClass": "TypeError"
          }
        }
      ]
    },
    {
      "name": "structural self iteration preserves concrete completion",
      "steps": [
        {
          "source": "function* f(it:IterableIterator.<uint8,string,void>){const x:uint8=yield* it;}",
          "expected": {
            "completion": "throw",
            "bodyEntered": false,
            "errorClass": "StaticTypeError",
            "diagnostic": {
              "code": "RT_ASSIGNABILITY",
              "phase": "static"
            }
          }
        }
      ]
    },
    {
      "name": "async structural self iteration preserves concrete completion",
      "steps": [
        {
          "source": "async function* f(it:AsyncIterableIterator.<uint8,string,void>){const x:uint8=yield* it;}",
          "expected": {
            "completion": "throw",
            "bodyEntered": false,
            "errorClass": "StaticTypeError",
            "diagnostic": {
              "code": "RT_ASSIGNABILITY",
              "phase": "static"
            }
          }
        }
      ]
    },
    {
      "name": "structural explicit undefined completion remains precise",
      "steps": [
        {
          "source": "function* f(it:IterableIterator.<uint8,undefined,void>){const x:undefined=yield* it;}\"ok\";",
          "expected": {
            "completion": "normal",
            "bodyEntered": true,
            "value": "ok"
          }
        }
      ]
    },
    {
      "name": "structural explicit string completion runs",
      "steps": [
        {
          "source": "const it:IterableIterator.<uint8,string,void>={next(){return {done:true,value:\"terminal\"};},[Symbol.iterator](){return this;}};function* g(){return yield* it;}const b=g().next();if(b.done===true&&b.value!==undefined){const x:string=b.value;}\"ok\";",
          "expected": {
            "completion": "normal",
            "bodyEntered": true,
            "value": "ok"
          }
        }
      ]
    }

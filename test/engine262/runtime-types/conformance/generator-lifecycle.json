{
  "cases": [
    {
      "name": "sync completion count 1",
      "steps": [
        {
          "source": "function* f():Generator.<uint8,string,void>{return \"done\";}const it=f();let x:any;for(let i=0;i<1;i++)x=it.next();String(x.done)+\":\"+String(x.value);",
          "expected": {
            "completion": "normal",
            "bodyEntered": true,
            "value": "true:done"
          }
        }
      ]
    },
    {

{
  "cases": [
    {
      "name": "default rejects function",
      "steps": [
        {
          "source": "function value(){return {mark:()=>0};}type M={mark?:any};meta M{subtype(a,b){return true;}default=value();}\"ok\";",
          "expected": {
            "completion": "throw",
            "bodyEntered": false,
            "scriptBodies": 0,
            "errorClass": "StaticTypeError",
            "diagnostic": {
              "rule": "rt-meta-declaration",
              "phase": "pre-evaluation"
            }
          }
        },
        {
          "source": "meta M{subtype(a,b){return true;}default={};}\"recovered\";",
          "expected": {
            "completion": "normal",
            "bodyEntered": true,
            "scriptBodies": 1,
            "value": "recovered"
          }
        }
      ]
    },

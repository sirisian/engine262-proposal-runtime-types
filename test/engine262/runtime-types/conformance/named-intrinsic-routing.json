      "steps": [
        {
          "source": "const outer:any=1..<3;const inner:any=5..<7;let n=0;function initial(){n++;return inner.reduce(initial:10,callback:(a,b)=>a+b);}String(outer.reduce(initial:initial(),callback:(a,b)=>a+b))+\"/\"+String(n);",
          "expected": {
            "completion": "normal",
            "bodyEntered": true,
            "scriptBodies": 1,
            "value": "24/1"
          }
        }
      ]
    },
    {
      "name": "value reference is rechecked after argument effects",
      "steps": [
        {
          "source": "const r:any=1..<3;let a:[].<uint8>=[5];function callback(){a.reserve(32);return (x,y)=>x+y;}let out=\"missed\";try{r.reduce(ref a[0],callback:callback());}catch(e){out=e instanceof TypeError?\"stale\":\"wrong\";}out;",
          "expected": {
            "completion": "normal",
            "bodyEntered": true,
            "scriptBodies": 1,
            "value": "stale"
          }
        }
      ]
    },

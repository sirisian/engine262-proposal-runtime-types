{
  "cases": [
    {
      "name": "typed named bigint step",
      "steps": [
        {
          "source": "const r=0n..<3001n;String(r.step(by:1000n).toArray());",
          "expected": {
            "completion": "normal",
            "bodyEntered": true,
            "scriptBodies": 1,
            "value": "0,1000,2000,3000"
          }
        }
      ]
    },
    {
      "name": "positional bigint step control",
      "steps": [
        {
          "source": "const r=0n..<3001n;String(r.step(1000n).toArray());",
          "expected": {
            "completion": "normal",
            "bodyEntered": true,
            "scriptBodies": 1,
            "value": "0,1000,2000,3000"
          }
        }
      ]
    },
    {
      "name": "named step object spread",
      "steps": [
        {
          "source": "const r:any=0..<5;String(r.step(...{by:2}).toArray());",
          "expected": {
            "completion": "normal",
            "bodyEntered": true,
            "scriptBodies": 1,
            "value": "0,2,4"
          }
        }
      ]
    },
    {
      "name": "empty spread retains native undefined-step validation",

{
  "cases": [
    {
      "name": "generic conflict prevents entry",
      "steps": [
        {
          "source": "interface Ordered<T:type>{v:T;}type NB<T:type extends Ordered.<T>>={nonZero?:boolean};meta NB<T:type extends Ordered.<T>>{subtype(a,b){return true;}default={};}type Other={nonZero?:number};globalThis.entered=true;meta Other{subtype(a,b){return true;}default={};}\"declared\";",
          "expected": {
            "completion": "throw",
            "bodyEntered": false,
            "scriptBodies": 0,
            "errorClass": "StaticTypeError",
            "diagnostic": {
              "rule": "rt-meta-declaration",
              "phase": "pre-evaluation"
            }
          }
        },
        {
          "source": "String(globalThis.entered);",
          "expected": {
            "completion": "normal",
            "bodyEntered": true,
            "scriptBodies": 1,
            "value": "undefined"
          }
        }
      ]
    },
    {
      "name": "partial key claims",

  "cases": [
    {
      "name": "known raw \"bad\" fails uint8 before source",
      "steps": [
        {
          "source": "globalThis.entered=true; primitive string{operator +(n:uint8):uint8{return \"bad\";}}\"unused\";",
          "expected": {
            "completion": "throw",
            "bodyEntered": false,
            "scriptBodies": 0,
            "errorClass": "StaticTypeError",
            "diagnostic": {
              "rule": "rt-assignability",
              "phase": "static"
            }
          }
        },
        {
          "source": "String(globalThis.entered);",
          "expected": {
            "completion": "normal",
            "bodyEntered": true,
            "scriptBodies": 1,
            "value": "undefined"
          }
        }
      ]
    },

    {
      "name": "class endpoints retain class domain without invoking order",
      "steps": [
        {
          "source": "let calls=0;class P{constructor(v){this.v=v;}operator<(o){calls++;return this.v<o.v;}}const r=new P(0)..<new P(5);`${r is Range.<P>};${r is Range.<number>};${calls}`;",
          "expected": {
            "completion": "normal",
            "bodyEntered": true,
            "value": "true;false;0"
          }
        }

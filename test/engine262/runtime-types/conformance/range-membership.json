    {
      "name": "typed endpoint identity is invariant",
      "steps": [
        {
          "source": "let a:uint8=0;let b:uint8=5;const r=a..<b;`${r is Range.<uint8>};${r is Range.<uint16>};${r is Range.<number>};${r is Range.<any>}`;",

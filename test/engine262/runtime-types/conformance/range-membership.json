    {
      "name": "both mixed endpoint domains survive reflection",
      "steps": [
        {
          "source": "let a:uint8=0;let b:uint16=5;const r=a..<b;String(Reflect.typeOf(r)===(type Range.<uint8|uint16>))+\";\"+String(r is Range.<uint8>);",

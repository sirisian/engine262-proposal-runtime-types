    {
      "name": "lazy reads stop on range failure [uint8,uint8]",
      "steps": [
        {
          "source": "function attempt(f:any){try{f();return \"ok\";}catch(e){return e.name;}}let trace=\"\";const raw:any=[];Object.defineProperty(raw,\"0\",{get(){trace+=\"a\";return 300;}});Object.defineProperty(raw,\"1\",{get(){trace+=\"b\";return 1;}});const e=attempt(()=>{const t:[uint8,uint8]=raw;});e+\"/\"+trace;",
          "expected": {
            "completion": "normal",
            "bodyEntered": true,
            "scriptBodies": 1,
            "value": "RangeError/a"
          }
        }
      ]
    },
    {
      "name": "first getter exception identity [uint8,uint8]",
      "steps": [
        {
          "source": "const marker={};let reads=0;const raw:any=[];Object.defineProperty(raw,\"0\",{get(){reads++;throw marker;}});Object.defineProperty(raw,\"1\",{get(){reads++;return 1;}});let same=false;try{const t:[uint8,uint8]=raw;}catch(e){same=e===marker;}same+\"/\"+reads;",
          "expected": {
            "completion": "normal",
            "bodyEntered": true,
            "scriptBodies": 1,
            "value": "true/1"
          }
        }
      ]
    },

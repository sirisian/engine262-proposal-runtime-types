    {
      "name": "independent-nested",
      "modules": {
        "main": "function make<T:type>():type{interface I<U:type=T>{value:U;}return I;}const A=make.<string>();const B=make.<number>();if(A.<>!==A.<string>||B.<>!==B.<number>||A.<> === B.<>)throw new Error(\"capture\");"
      },
      "expected": {
        "status": "fulfilled",
        "bodyEntries": [
          "main"
        ]
      }
    },
    {
      "name": "helper-shadow",
      "modules": {
        "main": "function outer<T:type>():type{function bound():type{return T;}interface I<T:type extends bound()=bound()>{value:T;}return I;}const A=outer.<string>();const B=outer.<number>();if(A.<>!==A.<string>||B.<>!==B.<number>)throw new Error(\"capture\");"
      },
      "expected": {
        "status": "fulfilled",
        "bodyEntries": [
          "main"
        ]
      }
    },
    {
      "name": "explicit-consumer",
      "modules": {
        "main": "import {Has} from \"dep\";function make():type{return number;}type A=Has.<make()>;if(A!==Has.<number>||Has.<make()>!==A)throw new Error(\"written\");",
        "dep": "import {make} from \"other\";export interface Has<T:type=make()>{value:T;}",
        "other": "export function make():type{return string;}"

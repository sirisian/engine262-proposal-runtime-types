        "other": "export function make():type{return string;}",
        "dep": "import {make} from \"other\";export interface Has<T:type=make()>{get():T;}",
        "main": "import {Has} from \"dep\";function make():type{return number;}type Applied=Has.<>;if(Applied!==Has.<string>)throw new Error(\"default\");"
      },
      "expected": {
        "status": "fulfilled",
        "bodyEntries": [
          "other",
          "dep",
          "main"
        ]
      }
    },

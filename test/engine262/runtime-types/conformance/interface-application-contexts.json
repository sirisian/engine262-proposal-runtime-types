      "modules": {
        "main": "import {Has} from \"dep\";function use<T:type>(i:any):type{return i.<>;}if(use.<number>(Has)!==Has.<string>)throw new Error(\"caller\");",
        "dep": "import {make} from \"other\";export interface Has<T:type=make()>{value:T;}",
        "other": "export function make():type{return string;}"
      },

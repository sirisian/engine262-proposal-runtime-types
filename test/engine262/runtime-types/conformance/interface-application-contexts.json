    {
      "name": "constraint-source-good",
      "modules": {
        "other": "export function make():type{return string;}",
        "dep": "import {make} from \"other\";export interface Has<T:type extends make()>{get():T;}",
        "main": "import {Has} from \"dep\";function make():type{return number;}type Applied=Has.<string>;if(Applied!==Has.<string>)throw new Error(\"constraint\");"
      },
      "expected": {
        "status": "fulfilled",
        "bodyEntries": [

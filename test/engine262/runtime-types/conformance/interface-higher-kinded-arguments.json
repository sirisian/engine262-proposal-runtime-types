{
  "clause": "sec-higher-kinded-parameters",
  "cases": [
    {
      "name": "direct",
      "modules": {
        "main": "interface I<T:type>{value:T;}interface H<W<_>:type>{}type A=H.<I>;if(A!==H.<I>)throw new Error(\"identity\");"
      },
      "expected": {
        "status": "fulfilled",
        "bodyEntries": [
          "main"
        ]
      }
    },
    {
      "name": "named",
      "modules": {
        "main": "interface I<T:type>{value:T;}interface H<W<_>:type>{}type A=H.<W:I>;"
      },

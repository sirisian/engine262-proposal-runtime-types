{
  "cases": [
    {
      "name": "registered result rejects an unused wrong destination",
      "steps": [
        {
          "source": "primitive string{operator +(n:uint8):uint8{return 7;}};\"seed\";",
          "expected": {
            "completion": "normal",
            "bodyEntered": true,
            "scriptBodies": 1,
            "value": "seed"
          }
        },
        {
          "source": "globalThis.entered=true;function f(s:string,n:uint8):string{return s+n;}\"bad\";",
          "expected": {
            "completion": "throw",
            "bodyEntered": false,
            "scriptBodies": 0,
            "errorClass": "StaticTypeError",
            "diagnostic": {
              "rule": "rt-assignability",
              "phase": "static"
            }
          }
        },
        {
          "source": "String(globalThis.entered);",
          "expected": {
            "completion": "normal",
            "bodyEntered": true,
            "scriptBodies": 1,
            "value": "undefined"
          }
        }
      ]
    },
    {
      "name": "registered result admits its true destination",
      "steps": [
        {
          "source": "primitive string{operator +(n:uint8):uint8{return 7;}};\"seed\";",
          "expected": {
            "completion": "normal",
            "bodyEntered": true,
            "scriptBodies": 1,
            "value": "seed"
          }
        },
        {
          "source": "function f(s:string,n:uint8):uint8{return s+n;}String(f(\"a\",(1:=uint8)));",
          "expected": {
            "completion": "normal",
            "bodyEntered": true,
            "scriptBodies": 1,
            "value": "7"
          }
        },
        {
          "source": "\"recovered\";",
          "expected": {
            "completion": "normal",
            "bodyEntered": true,
            "scriptBodies": 1,
            "value": "recovered"
          }
        }
      ]
    },

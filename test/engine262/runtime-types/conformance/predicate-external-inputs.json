    {
      "name": "cycle-caught-where",
      "modules": {
        "main": "import {marker} from \"dep\";const minimum=1;function allowed(n:uint32):boolean{try{return n>=minimum;}catch(e){return true;}}export type I<N:uint32> = uint32 where allowed(N);",
        "dep": "import {I} from \"main\";export const marker=1;I.<1>;"
      },
      "expected": {
        "status": "rejected",
        "bodyEntries": [],
        "errorClass": "StaticTypeError",
        "diagnostic": {
          "code": "RT_TYPE_EVALUATION",
          "phase": "pre-evaluation"
        }
      }
    },
